{
  "key": "useradmin-authentication-log",
  "displayName": "UserAdmin Authentication Log",
  "description": "Migrates the UserAdmin AuthenticationLog Azure Table to Cassandra activity storage.",
  "source": {
    "type": "azure-table",
    "connection": "user-storage",
    "tableName": "AuthenticationLog"
  },
  "target": {
    "type": "cassandra-activity",
    "table": "authentication_log",
    "keyField": "id",
    "timeField": "creation_date",
    "bucket": "Month",
    "partitionFields": ["organization_id"],
    "indexes": ["user_id", "user_name", "auth_type"],
    "retentionSeconds": null
  },
  "fields": [
    { "name": "id", "type": "text", "sources": ["$table", "PartitionKey", "RowKey"], "transform": "stable-id", "required": true },
    { "name": "organization_id", "type": "text", "source": "OrgId", "transform": "anonymous-org-id", "required": true },
    { "name": "organization", "type": "text", "source": "OrgName", "transform": "anonymous-org-name" },
    { "name": "creation_date", "type": "timestamp", "sources": ["TimeStamp", "$timestamp"], "transform": "first-date", "required": true },
    { "name": "ip_address", "type": "text", "source": "IPAddress" },
    { "name": "invite_id", "type": "text", "source": "InviteId" },
    { "name": "redirect_uri", "type": "text", "source": "RedirectUri" },
    { "name": "user_name", "type": "text", "source": "UserName" },
    { "name": "user_id", "type": "text", "source": "UserId" },
    { "name": "auth_type", "type": "text", "source": "AuthType" },
    { "name": "challenge_id", "type": "text", "source": "ChallengeId" },
    { "name": "credential_id", "type": "text", "source": "CredentialId" },
    { "name": "assertion_id", "type": "text", "source": "AssertionId" },
    { "name": "oauth_provider", "type": "text", "source": "OAuthProvider" },
    { "name": "extras", "type": "text", "source": "Extras" },
    { "name": "errors", "type": "text", "source": "Errors" }
  ]
}
