{
  "key": "ai-entity-field-recommendation",
  "displayName": "AI Entity Field Recommendation",
  "description": "Migrates entity field recommendations from Azure Table Storage to Cassandra operational storage.",
  "source": {
    "type": "azure-table",
    "connection": "ai-ml-table-storage",
    "tableName": "EntityFieldRecommendationDto"
  },
  "target": {
    "type": "cassandra-operational",
    "table": "entity_field_recommendation_operational_record",
    "keyField": "id",
    "timeField": "creation_date",
    "bucket": "All",
    "partitionFields": ["organization_id"],
    "indexes": ["entity_id", "status"],
    "retentionSeconds": null
  },
  "fields": [
    { "name": "id", "type": "text", "source": "Id", "required": true },
    { "name": "organization_id", "type": "text", "source": "OrgId", "required": true },
    { "name": "creation_date", "type": "timestamp", "sources": ["CreatedUtc", "$timestamp"], "transform": "first-date", "required": true },
    { "name": "last_updated_date", "type": "timestamp", "sources": ["AppliedUtc", "CreatedUtc", "$timestamp"], "transform": "first-date", "required": true },
    { "name": "entity_id", "type": "text", "source": "EntityId", "required": true },
    { "name": "entity_type", "type": "text", "source": "EntityType" },
    { "name": "entity_name", "type": "text", "source": "EntityName" },
    { "name": "review_id", "type": "text", "source": "ReviewId" },
    { "name": "report_type", "type": "text", "source": "ReportType" },
    { "name": "session_id", "type": "text", "source": "SessionId" },
    { "name": "turn_id", "type": "text", "source": "TurnId" },
    { "name": "update_id", "type": "text", "source": "UpdateId" },
    { "name": "step_key", "type": "text", "source": "StepKey" },
    { "name": "step_name", "type": "text", "source": "StepName" },
    { "name": "step_detail", "type": "text", "source": "StepDetail" },
    { "name": "issue_key", "type": "text", "source": "IssueKey" },
    { "name": "criterion_key", "type": "text", "source": "CriterionKey" },
    { "name": "field_name", "type": "text", "source": "FieldName" },
    { "name": "field_label", "type": "text", "source": "FieldLabel" },
    { "name": "original_value_json", "type": "text", "source": "OriginalValueJson" },
    { "name": "proposed_value_json", "type": "text", "source": "ProposedValueJson" },
    { "name": "original_value_blob_path", "type": "text", "source": "OriginalValueBlobPath" },
    { "name": "proposed_value_blob_path", "type": "text", "source": "ProposedValueBlobPath" },
    { "name": "has_large_values", "type": "boolean", "source": "HasLargeValues" },
    { "name": "reason", "type": "text", "source": "Reason" },
    { "name": "confidence", "type": "double", "source": "Confidence" },
    { "name": "risk_level", "type": "text", "source": "RiskLevel" },
    { "name": "requires_human_review", "type": "boolean", "source": "RequiresHumanReview" },
    { "name": "is_auto_applicable", "type": "boolean", "source": "IsAutoApplicable" },
    { "name": "reviewed_value_hash", "type": "text", "source": "ReviewedValueHash" },
    { "name": "status", "type": "text", "source": "Status" },
    { "name": "status_reason", "type": "text", "source": "StatusReason" },
    { "name": "created_utc", "type": "text", "source": "CreatedUtc" },
    { "name": "created_by_id", "type": "text", "source": "CreatedById" },
    { "name": "created_by_text", "type": "text", "source": "CreatedByText" },
    { "name": "applied_utc", "type": "text", "source": "AppliedUtc" },
    { "name": "applied_by_id", "type": "text", "source": "AppliedById" },
    { "name": "applied_by_text", "type": "text", "source": "AppliedByText" },
    { "name": "apply_mode", "type": "text", "source": "ApplyMode" },
    { "name": "applied_previous_value_json", "type": "text", "source": "AppliedPreviousValueJson" },
    { "name": "applied_value_json", "type": "text", "source": "AppliedValueJson" },
    { "name": "actual_value_hash_at_apply", "type": "text", "source": "ActualValueHashAtApply" },
    { "name": "apply_result_message", "type": "text", "source": "ApplyResultMessage" }
  ]
}
