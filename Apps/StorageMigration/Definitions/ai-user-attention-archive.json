{
  "key": "ai-user-attention-archive",
  "displayName": "AI User Attention Archive",
  "description": "Migrates archived AI user-attention projections from Azure Table Storage to Cassandra history storage.",
  "source": {
    "type": "azure-table",
    "connection": "ai-ml-table-storage",
    "tableName": "UserAttentionArchive"
  },
  "target": {
    "type": "cassandra-activity",
    "table": "user_attention_archive_record",
    "keyField": "id",
    "timeField": "creation_date",
    "bucket": "All",
    "partitionFields": [
      "organization_id"
    ],
    "indexes": [],
    "retentionSeconds": null
  },
  "fields": [
    {
      "name": "id",
      "type": "text",
      "source": "Id",
      "required": true
    },
    {
      "name": "organization_id",
      "type": "text",
      "source": "PartitionKey",
      "required": true
    },
    {
      "name": "organization",
      "type": "text",
      "source": "AssignedToUserText"
    },
    {
      "name": "creation_date",
      "type": "timestamp",
      "sources": [
        "ClosedUtc",
        "ResolvedUtc",
        "UpdatedUtc",
        "CreatedUtc",
        "$timestamp"
      ],
      "transform": "first-date",
      "required": true
    },
    {
      "name": "owner_organization_id",
      "type": "text",
      "source": "OwnerOrganizationId"
    },
    {
      "name": "assigned_to_user_id",
