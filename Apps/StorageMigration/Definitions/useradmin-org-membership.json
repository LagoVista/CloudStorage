      "source": "CreatedBy"
    },
    {
      "name": "CreatedById",
      "type": "text",
      "source": "CreatedById"
    },
    {
      "name": "LastUpdatedBy",
      "type": "text",
      "source": "LastUpdatedBy"
    },
    {
      "name": "LastUpdatedById",
      "type": "text",
      "source": "LastUpdatedById"
    },
    {
      "name": "IsEndUser",
      "type": "text",
      "source": "IsEndUser"
    },
    {
      "name": "Customer",
      "type": "text",
      "source": "Customer"
    },
    {
      "name": "CustomerId",
      "type": "text",
      "source": "CustomerId"
    },
    {
      "name": "CustomerContact",
      "type": "text",
