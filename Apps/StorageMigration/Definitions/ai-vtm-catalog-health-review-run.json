{
  "key": "ai-vtm-catalog-health-review-run",
  "displayName": "AI VTM Catalog Health Review Run",
  "description": "Migrates VTM catalog health review runs from Azure Table Storage to Cassandra operational storage.",
  "source": {
    "type": "azure-table",
    "connection": "ai-ml-table-storage",
    "tableName": "VtmCatalogHealthReviewRunDto"
  },
  "target": {
    "type": "cassandra-operational",
    "table": "vtm_catalog_health_review_run_operational_record",
    "keyField": "id",
    "timeField": "creation_date",
    "bucket": "All",
    "partitionFields": ["organization_id"],
    "indexes": [],
    "retentionSeconds": null
  },
  "fields": [
    { "name": "id", "type": "text", "source": "Id", "required": true },
    { "name": "organization_id", "type": "text", "source": "OrgId", "required": true },
    { "name": "creation_date", "type": "timestamp", "sources": ["StartedUtc", "$timestamp"], "transform": "first-date", "required": true },
    { "name": "last_updated_date", "type": "timestamp", "sources": ["CompletedUtc", "FailedUtc", "StartedUtc", "$timestamp"], "transform": "first-date", "required": true },
    { "name": "status", "type": "text", "source": "Status" },
    { "name": "started_utc", "type": "text", "source": "StartedUtc" },
    { "name": "completed_utc", "type": "text", "source": "CompletedUtc" },
    { "name": "failed_utc", "type": "text", "source": "FailedUtc" },
    { "name": "failure_reason", "type": "text", "source": "FailureReason" },
    { "name": "model", "type": "text", "source": "Model" },
    { "name": "catalog_snapshot_hash", "type": "text", "source": "CatalogSnapshotHash" },
    { "name": "prompt_hash", "type": "text", "source": "PromptHash" },
    { "name": "summary", "type": "text", "source": "Summary" },
    { "name": "virtual_team_member_count", "type": "int", "source": "VirtualTeamMemberCount" },
    { "name": "essential_job_activity_count", "type": "int", "source": "EssentialJobActivityCount" },
    { "name": "standard_operating_procedure_count", "type": "int", "source": "StandardOperatingProcedureCount" },
    { "name": "artifact_specification_count", "type": "int", "source": "ArtifactSpecificationCount" },
    { "name": "deficiency_candidate_count", "type": "int", "source": "DeficiencyCandidateCount" },
    { "name": "deficiency_created_count", "type": "int", "source": "DeficiencyCreatedCount" },
    { "name": "deficiency_updated_count", "type": "int", "source": "DeficiencyUpdatedCount" },
    { "name": "deficiency_skipped_count", "type": "int", "source": "DeficiencySkippedCount" },
    { "name": "deficiency_reopened_count", "type": "int", "source": "DeficiencyReopenedCount" },
    { "name": "deficiency_not_observed_count", "type": "int", "source": "DeficiencyNotObservedCount" },
    { "name": "p0_count", "type": "int", "source": "P0Count" },
    { "name": "p1_count", "type": "int", "source": "P1Count" },
    { "name": "p2_count", "type": "int", "source": "P2Count" },
    { "name": "p3_count", "type": "int", "source": "P3Count" },
    { "name": "p4_count", "type": "int", "source": "P4Count" },
    { "name": "s0_count", "type": "int", "source": "S0Count" },
    { "name": "s1_count", "type": "int", "source": "S1Count" },
    { "name": "s2_count", "type": "int", "source": "S2Count" },
    { "name": "s3_count", "type": "int", "source": "S3Count" },
    { "name": "a0_count", "type": "int", "source": "A0Count" },
    { "name": "a1_count", "type": "int", "source": "A1Count" },
    { "name": "a2_count", "type": "int", "source": "A2Count" },
    { "name": "a3_count", "type": "int", "source": "A3Count" },
    { "name": "orphaned_reference_count", "type": "int", "source": "OrphanedReferenceCount" },
    { "name": "duplicate_identity_count", "type": "int", "source": "DuplicateIdentityCount" },
    { "name": "missing_field_count", "type": "int", "source": "MissingFieldCount" },
    { "name": "missing_operation_count", "type": "int", "source": "MissingOperationCount" },
    { "name": "broken_chain_count", "type": "int", "source": "BrokenChainCount" },
    { "name": "weak_content_count", "type": "int", "source": "WeakContentCount" },
    { "name": "relationship_gap_count", "type": "int", "source": "RelationshipGapCount" },
    { "name": "strategic_gap_count", "type": "int", "source": "StrategicGapCount" },
    { "name": "created_by_id", "type": "text", "source": "CreatedById" },
    { "name": "created_by_text", "type": "text", "source": "CreatedByText" }
  ]
}
