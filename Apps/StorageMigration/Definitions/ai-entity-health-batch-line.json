{
  "key": "ai-entity-health-batch-line",
  "displayName": "AI Entity Health Batch Line",
  "description": "Migrates batch line rows from the mixed entityhealthbatches Azure table into the Cassandra conditional batch line store.",
  "source": {
    "type": "azure-table",
    "connection": "ai-ml-table-storage",
    "tableName": "entityhealthbatches",
    "rowKeyPrefix": "line:"
  },
  "target": {
    "type": "cassandra-operational",
    "table": "entity_health_batch_line_record",
    "keyField": "id",
    "timeField": "creation_date",
    "bucket": "All",
    "partitionFields": ["organization_id"],
    "indexes": [],
    "retentionSeconds": null
  },
  "fields": [
    { "name": "id", "type": "text", "source": "CustomId", "transform": "lowercase", "required": true },
    { "name": "organization_id", "type": "text", "source": "PartitionKey", "transform": "lowercase", "required": true },
    { "name": "creation_date", "type": "timestamp", "sources": ["$timestamp"], "transform": "first-date", "required": true },
    { "name": "last_updated_date", "type": "timestamp", "sources": ["$timestamp", "AppliedUtc", "ResultReceivedUtc", "LastApplyAttemptUtc"], "transform": "first-date", "required": true },
    { "name": "version", "type": "bigint", "transform": "constant", "value": 1, "required": true },
    { "name": "line_item_id", "type": "text", "source": "Id" },
    { "name": "execution_id", "type": "text", "source": "ExecutionId" },
    { "name": "request_hash", "type": "text", "source": "RequestHash" },
    { "name": "custom_id", "type": "text", "source": "CustomId" },
    { "name": "entity_type", "type": "text", "source": "EntityType" },
    { "name": "entity_id", "type": "text", "source": "EntityId" },
    { "name": "entity_name", "type": "text", "source": "EntityName" },
    { "name": "component_key", "type": "text", "source": "ComponentKey" },
    { "name": "stage_key", "type": "text", "source": "StageKey" },
    { "name": "stage_truth_sha256", "type": "text", "source": "StageTruthSha256" },
    { "name": "status", "type": "text", "source": "Status" },
    { "name": "result_blob_name", "type": "text", "source": "ResultBlobName" },
    { "name": "result_blob_etag", "type": "text", "source": "ResultBlobETag" },
    { "name": "result_length", "type": "bigint", "source": "ResultLength" },
    { "name": "result_received_utc", "type": "text", "source": "ResultReceivedUtc" },
    { "name": "error_message", "type": "text", "source": "ErrorMessage" },
    { "name": "apply_attempts", "type": "int", "source": "ApplyAttempts" },
    { "name": "last_apply_attempt_utc", "type": "text", "source": "LastApplyAttemptUtc" },
    { "name": "apply_lease_id", "type": "text", "source": "ApplyLeaseId" },
    { "name": "apply_lease_expires_utc", "type": "text", "source": "ApplyLeaseExpiresUtc" },
    { "name": "applied_utc", "type": "text", "source": "AppliedUtc" }
  ]
}
