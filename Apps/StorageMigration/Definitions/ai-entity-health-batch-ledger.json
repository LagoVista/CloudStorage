{
  "key": "ai-entity-health-batch-ledger",
  "displayName": "AI Entity Health Batch Ledger",
  "description": "Migrates append-only entity-health batch ledger rows from Azure Table Storage to Cassandra history storage.",
  "source": {
    "type": "azure-table",
    "connection": "ai-ml-table-storage",
    "tableName": "entityhealthbatchledger"
  },
  "target": {
    "type": "cassandra-activity",
    "table": "entity_health_batch_ledger_activity_record",
    "keyField": "id",
    "timeField": "creation_date",
    "bucket": "All",
    "partitionFields": ["organization_id"],
    "indexes": ["owner_organization_id"],
    "retentionSeconds": null
  },
  "fields": [
    { "name": "id", "type": "text", "source": "RowKey", "required": true },
    { "name": "organization_id", "type": "text", "source": "PartitionKey", "required": true },
    { "name": "organization", "type": "text", "source": "PartitionKey" },
    { "name": "creation_date", "type": "timestamp", "sources": ["CreatedUtc", "$timestamp"], "transform": "first-date", "required": true },
    { "name": "ledger_entry_id", "type": "text", "source": "Id", "required": true },
    { "name": "batch_execution_id", "type": "text", "source": "BatchExecutionId" },
    { "name": "job_execution_id", "type": "text", "source": "JobExecutionId" },
    { "name": "owner_organization_id", "type": "text", "source": "OwnerOrganizationId", "required": true },
    { "name": "event_type", "type": "text", "source": "EventType" },
    { "name": "operation", "type": "text", "source": "Operation" },
    { "name": "message", "type": "text", "source": "Message" },
    { "name": "status", "type": "text", "source": "Status" },
    { "name": "error_message", "type": "text", "source": "ErrorMessage" },
    { "name": "percent_complete", "type": "int", "source": "PercentComplete" },
    { "name": "current_count", "type": "int", "source": "CurrentCount" },
    { "name": "total_count", "type": "int", "source": "TotalCount" },
    { "name": "attempt", "type": "int", "source": "Attempt" },
    { "name": "candidate_count", "type": "int", "source": "CandidateCount" },
    { "name": "applied_count", "type": "int", "source": "AppliedCount" },
    { "name": "retry_pending_count", "type": "int", "source": "RetryPendingCount" },
    { "name": "completed_count", "type": "int", "source": "CompletedCount" },
    { "name": "failed_count", "type": "int", "source": "FailedCount" },
    { "name": "provider_completed_count", "type": "int", "source": "ProviderCompletedCount" },
    { "name": "provider_failed_count", "type": "int", "source": "ProviderFailedCount" },
    { "name": "provider_batch_id", "type": "text", "source": "ProviderBatchId" },
    { "name": "provider_status", "type": "text", "source": "ProviderStatus" },
    { "name": "provider_response_json", "type": "text", "source": "ProviderResponseJson" },
    { "name": "execution_id", "type": "text", "source": "ExecutionId" },
    { "name": "custom_id", "type": "text", "source": "CustomId" },
    { "name": "entity_type", "type": "text", "source": "EntityType" },
    { "name": "entity_id", "type": "text", "source": "EntityId" },
    { "name": "entity_name", "type": "text", "source": "EntityName" },
    { "name": "component_key", "type": "text", "source": "ComponentKey" },
    { "name": "stage_key", "type": "text", "source": "StageKey" },
    { "name": "item_status", "type": "text", "source": "ItemStatus" },
    { "name": "apply_attempts", "type": "int", "source": "ApplyAttempts" },
    { "name": "exception_type", "type": "text", "source": "ExceptionType" },
    { "name": "exception_message", "type": "text", "source": "ExceptionMessage" },
    { "name": "stack_trace", "type": "text", "source": "StackTrace" },
    { "name": "batch_created_utc", "type": "text", "source": "BatchCreatedUtc" },
    { "name": "submitted_utc", "type": "text", "source": "SubmittedUtc" },
    { "name": "results_received_utc", "type": "text", "source": "ResultsReceivedUtc" },
    { "name": "completed_utc", "type": "text", "source": "CompletedUtc" },
    { "name": "last_updated_utc", "type": "text", "source": "LastUpdatedUtc" },
    { "name": "created_utc", "type": "text", "source": "CreatedUtc" }
  ]
}
