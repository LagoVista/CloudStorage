<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>LagoVista.CloudStorage</id>
    <version>7.0.2</version>
    <authors>Software Logistics, LLC</authors>
    <owners>Software Logistics, LLC</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://www.nuviot.com</projectUrl>
    <iconUrl>http://bytemaster.blob.core.windows.net/icons/LagoVistaIcon.png</iconUrl>
    <description>Provides an abstact mechanism to store object graphs to cloud storage.</description>
    <copyright>Copyright Software Logistics - 2026</copyright>
    <tags>HomeAutomation IoT LagoVista</tags>
    <icon>LagoVistaIcon.png</icon>
    <repository url="https://www.github.com/lagovista" type="git" branch="master"></repository>
    <dependencies>
      <group targetFramework="netstandard2.1">
        <dependency id="Azure.Data.Tables" version="12.11.0" />
        <dependency id="Azure.Storage.Blobs" version="12.27.0" />
        <dependency id="CassandraCSharpDriver" version="3.22.0" />
        <dependency id="LagoVista.IoT.Logging" version="7.0.2" />
        <dependency id="log4net" version="3.3.1" />
        <dependency id="Microsoft.Azure.Cosmos" version="3.57.0" />
        <dependency id="Minio" version="7.0.0" />
        <dependency id="MongoDB.Driver" version="3.11.1" />
        <dependency id="OpenTelemetry.Api" version="1.15.3" />
        <dependency id="prometheus-net" version="8.2.1" />
        <dependency id="StackExchange.Redis" version="2.11.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="LagoVistaIcon.png" target="LagoVistaIcon.png" />
